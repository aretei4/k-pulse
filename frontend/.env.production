# Loaded by `npm run build` (Vite reads .env.production in production mode) and
# overrides .env. This is the config the deployed bundle ships with.

# Same-origin: nginx maps /kpulse/api/ -> the K-Pulse Spring Boot port, so the
# SPA needs no CORS and no absolute host. Requests become /kpulse/api/...
VITE_API_BASE_URL=/kpulse

# Never ship the in-memory mock dataset.
VITE_USE_MOCKS=false

# true  -> agents get the pre-election (house-level) flow only; the named-voter
#          roll and its sentiment screen are closed
# false -> the full agent app
VITE_PRE_ELECTION_ONLY=false
