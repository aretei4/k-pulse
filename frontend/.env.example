# Point the SPA at the Spring Boot API. Empty value uses the Vite dev proxy (/api -> localhost:8080).
VITE_API_BASE_URL=

# true  -> run entirely on in-memory mock data (no backend needed)
# false -> call the real Spring Boot API
VITE_USE_MOCKS=true

# true  -> agents get the pre-election (house-level) flow only; the named-voter
#          roll and its sentiment screen are closed
# false -> the full agent app
VITE_PRE_ELECTION_ONLY=false
