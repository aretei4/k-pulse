# Template for the per-environment secrets file on the server:
#
#   /home/ubuntu/app/kpulse-uat.properties     (profile uat)
#   /home/ubuntu/app/kpulse-prod.properties    (profile prod)
#
# Copy, fill in, and lock it down:
#
#   chmod 600 /home/ubuntu/app/kpulse-*.properties
#
# This .example is the only copy that belongs in git. Filled-in files never do.

spring.datasource.username=kpulse
spring.datasource.password=

# At least 32 random bytes. Generate one with:  openssl rand -base64 48
# Use a different value for uat and prod.
kpulse.jwt.secret=

# Admin login. Created on start if missing, and its password is reset to this
# value whenever they differ: change it here and restart to change the login.
# At least 8 characters. Leave both blank to leave existing admins untouched.
kpulse.admin.email=admin@k-pulse.in
kpulse.admin.password=
